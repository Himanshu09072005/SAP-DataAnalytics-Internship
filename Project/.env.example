# .env.example – fill in real values before running scripts or deploying
# ------------------------------------------------------------
# Database selection (mysql or postgres). For Render deployment use "postgres".
DB_TYPE=postgres

# Common credentials (used by both drivers)
DB_HOST=your_render_postgres_host
DB_PORT=5432
DB_USER=your_pg_user
DB_PASSWORD=your_pg_password
DB_NAME=sap-db

# Optional MySQL credentials (used only if DB_TYPE=mysql locally)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_pwd
# MYSQL_DB=chemical_procurement

# SQLite fallback (dev only) – leave empty unless you really need it
# SQLITE_PATH=/full/path/to/sap_erp.db

# JWT secret – generate a strong random value for production
SECRET_KEY=change_this_to_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Render will also expose the same variables as environment vars.

